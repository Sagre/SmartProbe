config MQTT_SERVER_ADDR
    string "MQTT Server Address"
    default "192.168.178.30"
    help
        The IP address or hostname of the MQTT broker.

config MQTT_SERVER_PORT
    int "MQTT Server Port"
    default 1883
    help
        The port number of the MQTT broker.

config MQTT_CLIENT_ID
    string "MQTT Client ID"
    default "zephyr_publisher"
    help
        The client ID to use when connecting to the MQTT broker.

config MQTT_CONNECT_TIMEOUT_MS
    int "MQTT Connect Timeout (ms)"
    default 2000
    help
        Timeout in milliseconds for MQTT connection attempts.

config MQTT_CONNECT_TRIES
    int "MQTT Connect Tries"
    default 10
    help
        Number of connection attempts before giving up.

config MQTT_BUFFER_SIZE
    int "MQTT Buffer Size"
    default 128
    help
        Size of the MQTT RX and TX buffers in bytes.

source "Kconfig.zephyr"